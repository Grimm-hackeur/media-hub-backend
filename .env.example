# =====================================================================================
# Media Hub — variables d'environnement
# Copiez vers apps/api/.env en local. Sur Render, saisissez-les dans "Environment".
# NE COMMITEZ JAMAIS un vrai .env. Aucun secret ne doit être préfixé VITE_ (public).
# L'API refuse de démarrer si une variable obligatoire manque ou est invalide
# (le message d'erreur donne le NOM de la variable, jamais sa valeur).
# =====================================================================================

# ---------- Base (obligatoire) ----------
NODE_ENV=development            # development | test | production
PORT=4000                       # Render injecte son propre PORT
LOG_LEVEL=info                  # fatal|error|warn|info|debug|trace|silent
# Nombre de reverse-proxies devant l'API (Render = 1). Sert à lire la vraie IP pour les limites de débit.
TRUST_PROXY=1

# ---------- MongoDB Atlas (obligatoire) ----------
# Utilisateur de base DÉDIÉ, rôle readWrite sur UNE seule base (pas atlasAdmin).
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.example.mongodb.net/media-hub?retryWrites=true&w=majority

# ---------- Sessions (obligatoire) ----------
# >= 32 caractères aléatoires :  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Sert à hacher les sessions et chiffrer le secret 2FA. Le changer déconnecte tout le monde.
SESSION_SECRET=remplacez-par-une-longue-valeur-aleatoire-d-au-moins-32-caracteres

# ---------- Origines autorisées (CORS + contrôle CSRF "Origin") ----------
# Origine publique EXACTE du frontend (schéma + domaine, sans chemin). Utilisée aussi dans les e-mails/redirections.
FRONTEND_URL=http://localhost:5173
# Origines supplémentaires, séparées par des virgules (ex. un domaine de préproduction). Facultatif.
FRONTEND_ORIGINS=
API_BASE_URL=http://localhost:4000

# ---------- E-mails transactionnels (Resend) ----------
# Sans clé : aucun e-mail n'est envoyé (donc pas d'inscription possible hors tests) et l'admin voit "non configuré".
RESEND_API_KEY=
EMAIL_FROM="Media Hub <no-reply@votre-domaine.example>"   # domaine vérifié chez Resend

# ---------- Google OAuth 2.0 / OpenID Connect (facultatif) ----------
# Les TROIS doivent être renseignées, sinon la connexion Google est désactivée (503 explicite).
# GOOGLE_CALLBACK_URL doit être IDENTIQUE à l'"URI de redirection autorisée" saisie dans Google Cloud Console.
# Avec la réécriture Vercel (même origine) : https://VOTRE-FRONT/api/v1/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/api/v1/auth/google/callback

# ---------- Administration ----------
# true = un admin doit avoir activé la 2FA (TOTP) pour utiliser /api/v1/admin. Recommandé en production.
REQUIRE_ADMIN_2FA=false

# ---------- Fournisseurs de médias ----------
# FACEBOOK : suit le code de bot que vous avez fourni (endpoint siputzx). Pas de clé requise.
SIPUTZX_BASE_URL=https://api.siputzx.my.id
FACEBOOK_API_PATH=/api/d/facebook
# TIKTOK / INSTAGRAM : AUCUN endpoint ni format de réponse fournis -> adaptateurs "non connectés" (503 explicite).
# Quand vous aurez la doc, ajoutez ici TIKTOK_API_BASE_URL / TIKTOK_API_KEY etc. et fournissez-moi la doc.

# ---------- Recherche musicale ----------
# itunes = API publique Apple Search (métadonnées + extraits de 30 s, SANS téléchargement, sans clé). none = désactivée.
MUSIC_PROVIDER=itunes

# ---------- Fonctions IA (facultatif, facturées par le fournisseur) ----------
# Appelées UNIQUEMENT côté serveur. Les deux sont requises pour activer l'IA.
ANTHROPIC_API_KEY=
AI_MODEL=
AI_DAILY_LIMIT=20               # requêtes IA par utilisateur et par 24 h

# =====================================================================================
# apps/web (frontend) — VITE_* est PUBLIC : jamais de secret ici
# =====================================================================================
VITE_API_URL=/api/v1
